# Benutzereinheit des Kamera-Dienstes (Plan 6). installieren.sh legt sie nach
# ~/.config/systemd/user/dss-kamera.service; Protokoll: journalctl --user -u dss-kamera
# Quellen (nicht abgerufen):
#   https://www.freedesktop.org/software/systemd/man/latest/systemd.service.html
#   https://www.freedesktop.org/software/systemd/man/latest/systemd.unit.html (Bezeichner %h)

[Unit]
Description=Kamera-Dienst des DoNs Streaming Studio

[Service]
Type=simple
WorkingDirectory=%h/.local/opt/dss-kamera
ExecStart=/usr/bin/env python3 -m dss_camera
# Auch wenn die Lauschadresse beim Anmelden noch fehlt (Exit-Code 4): nach 5 s nochmals.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
